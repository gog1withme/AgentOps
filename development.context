### Step 9 — Alerts engine

**File:** `cli/collector/alerts.go`

All original rules plus:

```sql
-- Budget at 80% threshold
SELECT SUM(cost_usd) / budget_limit * 100 as pct
FROM events e JOIN budgets b ON e.session_id = b.session_id
WHERE e.session_id = ? AND pct >= 80

-- Low efficiency: session average below 30%
SELECT AVG(efficiency_score) as avg_eff
FROM events WHERE session_id = ? AND type = 'llm_call'
HAVING avg_eff < 30

-- MCP latency spike: server's recent avg > 3x its historical avg
SELECT mcp_server,
    AVG(mcp_latency_ms) FILTER (WHERE timestamp > now() - INTERVAL '5 minutes') as recent,
    AVG(mcp_latency_ms) as historical
FROM events WHERE type = 'mcp_call' AND mcp_server = ?
HAVING recent > historical * 3

-- MCP error spike: >10% error rate in last 50 calls
SELECT mcp_server, COUNT(*) FILTER (WHERE error IS NOT NULL) / COUNT(*) as err_rate
FROM events WHERE type = 'mcp_call' AND mcp_server = ?
ORDER BY timestamp DESC LIMIT 50
HAVING err_rate > 0.10

-- Prompt regression: new prompt hash has >20% higher cost than previous
SELECT prompt_hash, avg_cost_usd FROM prompts
ORDER BY first_seen DESC LIMIT 2
-- check if newest / previous > 1.2
```

